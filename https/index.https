<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#100e1b" />
  <title>Павла — твой день рождения</title>
  <style>
    :root {
      color-scheme: dark;
      --bg: #100e1b;
      --bg2: #1d142b;
      --pink: #ff9bc8;
      --violet: #b6a2ff;
      --gold: #ffe0a6;
      --accent: #ff9bc8;
      --accent2: #a68cff;
      --glow: rgba(255, 155, 200, .30);
      --text: #fffaff;
      --muted: rgba(255,250,255,.66);
      --glass: rgba(255,255,255,.075);
      --line: rgba(255,255,255,.14);
      --mx: 50vw;
      --my: 30vh;
    }
    * { box-sizing: border-box; }
    html { min-height: 100%; scroll-behavior: smooth; }
    body {
      margin: 0;
      min-height: 100vh;
      overflow-x: hidden;
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", sans-serif;
      background:
        radial-gradient(ellipse at 18% 12%, color-mix(in srgb, var(--accent) 18%, transparent), transparent 36%),
        radial-gradient(ellipse at 85% 22%, color-mix(in srgb, var(--accent2) 20%, transparent), transparent 38%),
        linear-gradient(145deg, var(--bg), var(--bg2) 58%, #0c0b15);
      transition: background 1s ease;
    }
    body::before {
      content: "";
      position: fixed; inset: 0; z-index: 0; pointer-events: none;
      background: radial-gradient(560px circle at var(--mx) var(--my), rgba(255,255,255,.105), transparent 62%);
      mix-blend-mode: screen;
    }
    body::after {
      content: ""; position: fixed; inset: 0; z-index: 0; pointer-events: none;
      opacity: .12;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.2'/%3E%3C/svg%3E");
    }
    .ambient { position: fixed; inset: 0; overflow: hidden; pointer-events: none; z-index: 0; }
    .orb { position: absolute; border-radius: 50%; filter: blur(50px); opacity: .42; animation: drift 16s ease-in-out infinite alternate; }
    .orb.one { width: 360px; height: 360px; background: var(--accent); top: -140px; left: -110px; }
    .orb.two { width: 430px; height: 430px; background: var(--accent2); right: -180px; top: 18%; animation-delay: -5s; }
    .orb.three { width: 300px; height: 300px; background: #ed9bba; left: 28%; bottom: -190px; animation-delay: -9s; }
    @keyframes drift { from { transform: translate3d(-18px,-12px,0) scale(.94); } to { transform: translate3d(35px,28px,0) scale(1.12); } }
    .stars { position: fixed; inset: 0; z-index: 0; pointer-events: none; }
    .star { position: absolute; width: 3px; height: 3px; border-radius: 50%; background: #fff; box-shadow: 0 0 10px 2px rgba(255,255,255,.7); opacity: .45; animation: twinkle 3.4s ease-in-out infinite; }
    @keyframes twinkle { 0%,100% { opacity: .18; transform: scale(.7); } 50% { opacity: .9; transform: scale(1.45); } }
    .page { position: relative; z-index: 1; width: min(1120px, calc(100% - 40px)); margin: auto; min-height: 100vh; display: flex; flex-direction: column; }
    header { display:flex; align-items:center; justify-content:space-between; padding: 28px 0; gap: 20px; }
    .brand { display:flex; align-items:center; gap:10px; color:rgba(255,255,255,.8); font-size:13px; letter-spacing:.16em; text-transform:uppercase; }
    .brand-mark { width:28px; height:28px; display:grid; place-items:center; border:1px solid var(--line); border-radius:10px; background:rgba(255,255,255,.08); box-shadow:0 0 24px var(--glow); }
    .date-chip { padding:10px 15px; border:1px solid var(--line); border-radius:99px; background:rgba(255,255,255,.055); backdrop-filter:blur(18px); color:rgba(255,255,255,.76); font-size:11px; letter-spacing:.16em; }
    main { flex:1; display:grid; place-items:center; padding: 26px 0 72px; }
    .hero { width:min(820px,100%); text-align:center; animation: rise 1.1s cubic-bezier(.2,.75,.2,1) both; }
    @keyframes rise { from { opacity:0; transform:translateY(24px) scale(.985); } to { opacity:1; transform:translateY(0) scale(1); } }
    .eyebrow { display:inline-flex; align-items:center; gap:9px; color:rgba(255,255,255,.68); text-transform:uppercase; letter-spacing:.24em; font-size:10px; margin-bottom:20px; }
    .eyebrow::before,.eyebrow::after { content:""; width:28px; height:1px; background:linear-gradient(90deg,transparent,var(--accent)); }
    .eyebrow::after { transform:rotate(180deg); }
    h1 { margin:0; font-size:clamp(54px, 10vw, 104px); line-height:.98; letter-spacing:-.065em; font-weight:650; text-shadow:0 8px 70px var(--glow); }
    .name-gradient { background:linear-gradient(110deg,#fff 8%,var(--pink) 42%,#e1d6ff 74%,#fff 100%); -webkit-background-clip:text; background-clip:text; color:transparent; background-size:180% auto; animation: shimmer 7s ease-in-out infinite; }
    @keyframes shimmer { 0%,100% { background-position:0% center; } 50% { background-position:100% center; } }
    .subtitle { margin:20px auto 0; max-width:560px; color:var(--muted); font-size:clamp(15px,2vw,18px); line-height:1.65; font-weight:350; }
    .age-wrap { position:relative; display:inline-grid; place-items:center; margin:36px 0 26px; width:190px; height:190px; }
    .age-ring { position:absolute; inset:0; border-radius:50%; border:1px solid rgba(255,255,255,.2); box-shadow:inset 0 0 35px rgba(255,255,255,.035),0 0 65px var(--glow); animation: breathe 4.8s ease-in-out infinite; }
    .age-ring::before,.age-ring::after { content:""; position:absolute; inset:10px; border:1px solid rgba(255,255,255,.12); border-radius:50%; }
    .age-ring::after { inset:-7px; border-color:color-mix(in srgb,var(--accent) 35%,transparent); border-style:dashed; animation: spin 34s linear infinite; }
    @keyframes spin { to { transform:rotate(360deg); } }
    @keyframes breathe { 0%,100% { transform:scale(.97); opacity:.72; } 50% { transform:scale(1.035); opacity:1; } }
    .age-number { font-size:100px; line-height:1; font-weight:250; letter-spacing:-.09em; padding-right:10px; background:linear-gradient(155deg,#fff 12%,var(--gold) 55%,var(--accent) 100%); -webkit-background-clip:text; background-clip:text; color:transparent; filter:drop-shadow(0 0 22px var(--glow)); }
    .age-label { position:absolute; bottom:32px; font-size:10px; letter-spacing:.28em; text-transform:uppercase; color:rgba(255,255,255,.65); }
    .countdown { display:flex; justify-content:center; gap:10px; margin: 4px auto 30px; }
    .time-box { width:86px; padding:14px 8px 12px; border-radius:18px; border:1px solid var(--line); background:linear-gradient(145deg,rgba(255,255,255,.09),rgba(255,255,255,.025)); backdrop-filter:blur(18px); box-shadow:0 14px 34px rgba(0,0,0,.12),inset 0 1px rgba(255,255,255,.08); }
    .time-value { display:block; font-variant-numeric:tabular-nums; font-size:29px; font-weight:500; letter-spacing:-.04em; }
    .time-label { display:block; margin-top:4px; color:rgba(255,255,255,.5); font-size:9px; text-transform:uppercase; letter-spacing:.16em; }
    .glass-card { position:relative; overflow:hidden; width:min(590px,100%); margin:0 auto; padding:24px; border:1px solid rgba(255,255,255,.17); border-radius:28px; background:linear-gradient(135deg,rgba(255,255,255,.105),rgba(255,255,255,.035)); backdrop-filter:blur(24px); box-shadow:0 25px 90px rgba(0,0,0,.22),inset 0 1px rgba(255,255,255,.12); }
    .glass-card::before { content:""; position:absolute; width:260px; height:160px; top:-130px; left:15%; background:var(--accent); filter:blur(75px); opacity:.22; pointer-events:none; }
    .card-kicker { color:rgba(255,255,255,.5); font-size:10px; letter-spacing:.22em; text-transform:uppercase; }
    .card-copy { margin:10px 0 18px; color:rgba(255,255,255,.86); font-size:15px; line-height:1.6; }
    button { font:inherit; cursor:pointer; }
    .surprise-btn { position:relative; isolation:isolate; overflow:hidden; display:inline-flex; align-items:center; justify-content:center; gap:10px; min-height:48px; padding:0 22px; border:0; border-radius:99px; color:#241526; background:linear-gradient(110deg,#ffe7ed,#f8c6df 48%,#e3d6ff); box-shadow:0 8px 30px var(--glow),inset 0 1px rgba(255,255,255,.9); font-size:13px; font-weight:650; transition:transform .25s ease,box-shadow .25s ease; }
    .surprise-btn::before { content:""; position:absolute; z-index:-1; inset:0; transform:translateX(-120%); background:linear-gradient(100deg,transparent,rgba(255,255,255,.7),transparent); transition:transform .7s ease; }
    .surprise-btn:hover { transform:translateY(-3px); box-shadow:0 13px 38px var(--glow),inset 0 1px rgba(255,255,255,.9); }
    .surprise-btn:hover::before { transform:translateX(120%); }
    .wish { display:none; margin:22px auto 0; max-width:460px; padding-top:19px; border-top:1px solid rgba(255,255,255,.13); animation: wishIn .8s cubic-bezier(.2,.8,.2,1) both; }
    .wish.show { display:block; }
    @keyframes wishIn { from { opacity:0; transform:translateY(12px); } to { opacity:1; transform:translateY(0); } }
    .wish p { margin:0; color:rgba(255,255,255,.88); font-size:15px; line-height:1.8; }
    .wish .sign { margin-top:13px; color:var(--accent); font-size:12px; letter-spacing:.12em; }
    /* Photo revealed inside the gift */
    .gift-photo-frame { width:min(100%,420px); margin:22px auto 0; padding:9px; border:1px solid rgba(255,255,255,.28); border-radius:23px; background:linear-gradient(145deg,rgba(255,255,255,.16),rgba(255,255,255,.045)); box-shadow:0 18px 55px rgba(0,0,0,.24),0 0 34px var(--glow),inset 0 1px rgba(255,255,255,.35); opacity:0; transform:translateY(18px) scale(.94); }
    .wish.show .gift-photo-frame { animation:photoReveal .95s cubic-bezier(.18,.8,.2,1) .12s both; }
    .gift-photo-frame img { display:block; width:100%; aspect-ratio:4/3; object-fit:cover; object-position:center; border-radius:16px; }
    .gift-photo-frame figcaption { padding:12px 5px 3px; color:rgba(255,255,255,.74); font-size:10px; letter-spacing:.16em; text-transform:uppercase; }
    @keyframes photoReveal { 0% { opacity:0; transform:translateY(24px) scale(.9); filter:blur(7px); } 65% { opacity:1; transform:translateY(-3px) scale(1.015); filter:blur(0); } 100% { opacity:1; transform:translateY(0) scale(1); filter:blur(0); } }
    .controls { display:flex; justify-content:center; align-items:center; gap:9px; margin-top:24px; flex-wrap:wrap; }
    .theme-label { color:rgba(255,255,255,.42); font-size:10px; letter-spacing:.14em; text-transform:uppercase; margin-right:3px; }
    .theme-btn { width:28px; height:28px; border-radius:50%; border:1px solid rgba(255,255,255,.38); background:var(--swatch); box-shadow:0 0 18px color-mix(in srgb,var(--swatch) 42%,transparent); transition:transform .2s ease,outline .2s ease; }
    .theme-btn:hover { transform:scale(1.16); }
    .theme-btn[aria-pressed="true"] { outline:2px solid rgba(255,255,255,.85); outline-offset:3px; }
    footer { padding:22px 0 27px; display:flex; justify-content:center; color:rgba(255,255,255,.35); font-size:10px; letter-spacing:.12em; text-align:center; }
    .heart { display:inline-block; color:#ff9fc5; animation: heartbeat 1.7s ease-in-out infinite; margin:0 4px; }
    @keyframes heartbeat { 0%,100% { transform:scale(1); } 12% { transform:scale(1.22); } 24% { transform:scale(1); } 36% { transform:scale(1.13); } }
    .confetti { position:fixed; z-index:5; top:-20px; width:8px; height:13px; border-radius:2px; pointer-events:none; animation:fall var(--duration) linear forwards; }
    @keyframes fall { to { transform:translate3d(var(--drift),110vh,0) rotate(760deg); opacity:.1; } }
    .sparkle { display:inline-block; animation: sparkle 2.5s ease-in-out infinite; }
    @keyframes sparkle { 0%,100% { transform:rotate(0) scale(.9); opacity:.7; } 50% { transform:rotate(18deg) scale(1.2); opacity:1; } }
    /* Interactive gift reveal */
    .gift-stage { position:relative; display:grid; justify-items:center; margin:18px auto 16px; min-height:190px; }
    .gift-stage::before { content:""; position:absolute; width:190px; height:120px; bottom:13px; border-radius:50%; background:var(--glow); filter:blur(28px); opacity:.85; transition:transform .8s ease,opacity .8s ease; }
    .gift-trigger { position:relative; z-index:1; display:grid; justify-items:center; gap:10px; padding:8px 18px 2px; border:0; background:transparent; color:inherit; border-radius:20px; }
    .gift-trigger:focus-visible,.music-btn:focus-visible { outline:2px solid rgba(255,255,255,.95); outline-offset:5px; }
    .gift-box { position:relative; display:block; width:158px; height:126px; perspective:700px; filter:drop-shadow(0 18px 20px rgba(0,0,0,.25)); }
    .gift-body { position:absolute; left:12px; bottom:0; width:134px; height:91px; overflow:hidden; border:1px solid rgba(255,255,255,.55); border-radius:9px 9px 15px 15px; background:linear-gradient(130deg,#ffd7e8 0%,#f59ac7 48%,#b58ee9 100%); box-shadow:inset 0 2px 10px rgba(255,255,255,.38),inset 0 -12px 24px rgba(95,45,111,.18); transition:transform .65s cubic-bezier(.2,.8,.2,1),filter .65s ease; }
    .gift-body::before { content:""; position:absolute; inset:0 auto 0 50%; width:22px; transform:translateX(-50%); background:linear-gradient(90deg,#fff0b8,#fff9df 48%,#f6c96d); box-shadow:0 0 15px rgba(255,236,174,.55); }
    .gift-lid { position:absolute; z-index:2; left:4px; top:25px; width:150px; height:30px; border:1px solid rgba(255,255,255,.72); border-radius:8px; background:linear-gradient(135deg,#ffe8ef,#ffadd0 55%,#d7baff); box-shadow:inset 0 2px 8px rgba(255,255,255,.7),0 6px 15px rgba(0,0,0,.16); transform-origin:12% 85%; transition:transform .8s cubic-bezier(.18,.78,.2,1),filter .8s ease; }
    .gift-lid::after { content:""; position:absolute; left:50%; top:0; bottom:0; width:22px; transform:translateX(-50%); background:linear-gradient(90deg,#fff0b8,#fff9df 48%,#f6c96d); }
    .gift-bow { position:absolute; z-index:3; left:50%; top:-19px; width:48px; height:28px; transform:translateX(-50%); }
    .gift-bow::before,.gift-bow::after { content:""; position:absolute; top:2px; width:25px; height:20px; border:5px solid #ffe9a9; box-shadow:0 0 13px rgba(255,235,167,.6); }
    .gift-bow::before { right:21px; border-radius:90% 12% 75% 20%; transform:rotate(25deg); }
    .gift-bow::after { left:21px; border-radius:12% 90% 20% 75%; transform:rotate(-25deg); }
    .gift-stage.open .gift-lid { transform:translate(-22px,-65px) rotate(-32deg); filter:brightness(1.12); }
    .gift-stage.open .gift-body { transform:translateY(8px) scale(1.035); filter:brightness(1.12); }
    .gift-stage.open::before { transform:scale(1.35); opacity:1; }
    .gift-trigger:hover .gift-box { transform:translateY(-4px) rotate(-2deg); }
    .gift-box { transition:transform .3s ease; }
    .gift-hint { color:rgba(255,255,255,.65); font-size:10px; letter-spacing:.16em; text-transform:uppercase; transition:color .3s ease; }
    .gift-stage.open .gift-hint { color:var(--gold); }
    .gift-sparkle { position:absolute; z-index:0; color:#fff0b8; font-size:18px; opacity:0; text-shadow:0 0 15px #fff; pointer-events:none; }
    .gift-stage.open .gift-sparkle { animation:giftSpark .9s ease-out both; }
    .gift-sparkle.s1 { left:calc(50% - 94px); top:20px; }
    .gift-sparkle.s2 { right:calc(50% - 98px); top:36px; animation-delay:.12s; }
    .gift-sparkle.s3 { left:calc(50% - 72px); top:88px; animation-delay:.2s; }
    @keyframes giftSpark { 0% { opacity:0; transform:translateY(18px) scale(.3) rotate(-25deg); } 45% { opacity:1; transform:translateY(-13px) scale(1.35) rotate(15deg); } 100% { opacity:0; transform:translateY(-34px) scale(.75) rotate(35deg); } }

    /* User-selected local music player */
    .music-card { width:min(590px,100%); margin:18px auto 0; padding:18px 20px; display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap; text-align:left; border:1px solid rgba(255,255,255,.15); border-radius:23px; background:linear-gradient(135deg,rgba(255,255,255,.085),rgba(255,255,255,.025)); backdrop-filter:blur(22px); box-shadow:0 18px 55px rgba(0,0,0,.15),inset 0 1px rgba(255,255,255,.08); }
    .music-info { min-width:160px; flex:1; }
    .music-kicker { color:rgba(255,255,255,.48); font-size:9px; letter-spacing:.2em; text-transform:uppercase; }
    .music-title { margin-top:7px; color:rgba(255,255,255,.9); font-size:13px; overflow-wrap:anywhere; }
    .music-status { margin-top:5px; color:rgba(255,255,255,.48); font-size:10px; }
    .music-actions { display:flex; align-items:center; justify-content:center; gap:8px; flex-wrap:wrap; }
    .music-btn { min-height:40px; padding:0 15px; border:1px solid rgba(255,255,255,.2); border-radius:99px; background:rgba(255,255,255,.075); color:#fff; font-size:11px; transition:transform .2s ease,background .2s ease,border-color .2s ease; }
    .music-btn:hover:not(:disabled) { transform:translateY(-2px); background:rgba(255,255,255,.14); border-color:rgba(255,255,255,.4); }
    .music-btn.primary { border:0; color:#241526; font-weight:650; background:linear-gradient(110deg,#ffe7ed,#f8c6df 48%,#e3d6ff); box-shadow:0 6px 22px var(--glow); }
    .music-btn:disabled { opacity:.38; cursor:not-allowed; }
    .music-bars { display:inline-flex; align-items:center; gap:3px; height:13px; margin-right:7px; vertical-align:middle; }
    .music-bars i { display:block; width:2px; height:5px; border-radius:3px; background:currentColor; }
    .music-card.playing .music-bars i { animation:musicWave .75s ease-in-out infinite alternate; }
    .music-card.playing .music-bars i:nth-child(2) { animation-delay:.18s; }
    .music-card.playing .music-bars i:nth-child(3) { animation-delay:.34s; }
    .music-card.playing .music-bars i:nth-child(4) { animation-delay:.1s; }
    @keyframes musicWave { to { height:13px; } }
    .visually-hidden { position:absolute !important; width:1px !important; height:1px !important; padding:0 !important; margin:-1px !important; overflow:hidden !important; clip:rect(0,0,0,0) !important; white-space:nowrap !important; border:0 !important; }

    @media (max-width:600px) {
      .page { width:min(100% - 28px, 520px); }
      header { padding:20px 0; }
      .brand { font-size:10px; letter-spacing:.1em; }
      .brand-mark { width:25px; height:25px; }
      .date-chip { padding:8px 10px; font-size:9px; letter-spacing:.1em; }
      main { padding:22px 0 45px; }
      .age-wrap { width:158px; height:158px; margin:30px 0 22px; }
      .age-number { font-size:84px; }
      .age-label { bottom:26px; }
      .time-box { width:73px; border-radius:15px; padding:12px 5px 10px; }
      .time-value { font-size:25px; }
      .glass-card { padding:21px 17px; border-radius:23px; }
      .subtitle { max-width:360px; }
      .music-card { padding:17px 15px; justify-content:center; text-align:center; }
      .music-info { flex-basis:100%; }
      .music-actions { width:100%; }
      .music-btn { flex:1; }
    }
    @media (prefers-reduced-motion: reduce) {
      *,*::before,*::after { animation-duration:.01ms !important; animation-iteration-count:1 !important; scroll-behavior:auto !important; transition-duration:.01ms !important; }
    }
  </style>
</head>
<body>
  <div class="ambient" aria-hidden="true"><div class="orb one"></div><div class="orb two"></div><div class="orb three"></div></div>
  <div class="stars" id="stars" aria-hidden="true"></div>
  <div class="page">
    <header>
      <div class="date-chip">27 НОЯБРЯ · 2026</div>
    </header>

    <main>
      <section class="hero" aria-labelledby="title">
        <div class="eyebrow">самый лучший день</div>
        <h1 id="title"><span class="name-gradient">Павла</span></h1>
        <p class="subtitle">Совсем скоро тебе будет 16 лет. Пусть в ней будет больше радости, больше ярких моментов, от которых хочется улыбаться.</p>

        <div class="age-wrap" aria-label="Тебе исполнится 16 лет">
          <div class="age-ring"></div>
          <div class="age-number">16</div>
          <div class="age-label">твое день рождения</div>
        </div>

        <div class="countdown" aria-label="Обратный отсчёт до дня рождения">
          <div class="time-box"><span class="time-value" id="days">—</span><span class="time-label">дней</span></div>
          <div class="time-box"><span class="time-value" id="hours">—</span><span class="time-label">часов</span></div>
          <div class="time-box"><span class="time-value" id="minutes">—</span><span class="time-label">минут</span></div>
          <div class="time-box"><span class="time-value" id="seconds">—</span><span class="time-label">секунд</span></div>
        </div>

        <div class="glass-card">
          <div class="card-kicker"><span class="sparkle">✧</span> маленький сюрприз</div>
          <p class="card-copy">Для одного особенного человека приготовлено кое-что тёплое. Нажми — и пусть праздник начнётся чуть раньше.</p>
          <div class="gift-stage" id="giftStage">
            <span class="gift-sparkle s1" aria-hidden="true">✦</span>
            <span class="gift-sparkle s2" aria-hidden="true">✧</span>
            <span class="gift-sparkle s3" aria-hidden="true">✦</span>
            <button class="gift-trigger" id="giftTrigger" type="button" aria-label="Открыть подарок" aria-pressed="false">
              <span class="gift-box" aria-hidden="true">
                <span class="gift-lid"><span class="gift-bow"></span></span>
                <span class="gift-body"></span>
              </span>
              <span class="gift-hint" id="giftHint">Нажми на подарок</span>
            </button>
          </div>
          <button class="surprise-btn" id="surpriseBtn" type="button"><span>Открыть сюрприз</span><span aria-hidden="true">♡</span></button>
          <div class="wish" id="wish" aria-live="polite">

            <p>Я просто хочу, чтобы ты знала, насколько ты мне дорога. ❤️ Как я тебя очень сильно ценю и ты самое дорогое что у меня есть.

Мне нравится абсолютно всё в тебе — твой характер, твоя улыбка. Для меня ты всегда остаёшься самой любимой. 

Я правда часто думаю о тебе: как ты, всё ли у тебя хорошо, не устала ли, ничего ли тебя не тревожит. И это уже как-то само собой, потому что ты стала частью моей жизни.

Спасибо тебе за то, что ты есть у меня. За наши разговоры, смех, моменты вместе и просто за то чувство, которое появляется у меня, когда я понимаю, что ты рядом.

Я очень тебя люблю и правда не хочу тебя терять. Ты для меня намного больше, чем просто любимый человек. Ты — мой родной человек. ❤️.</p>
            <div class="sign">С ЛЮБОВЬЮ ❤️❤️❤️</div>
            <figure class="gift-photo-frame" id="giftPhoto">
              <img src="data:image/jpeg;base64," alt="Фотография для Павлы" loading="lazy" />
              <figcaption>особенный момент ✧</figcaption>
            </figure>
          </div>
        </div>

        <section class="music-card" id="musicCard" aria-label="Музыкальное сопровождение">
          <div class="music-info">
            <div class="music-kicker"><span class="music-bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>музыка для этого момента</div>
            <div class="music-title" id="musicTrackName">Твоя особенная песня</div>
            <div class="music-status" id="musicStatus" aria-live="polite">Добавь файл song.mp3 в папку сайта</div>
          </div>
          <div class="music-actions">
            <button class="music-btn primary" id="musicToggleBtn" type="button" disabled aria-pressed="false">Включить</button>
          </div>
          <audio id="birthdayAudio" src="./song.mp3" preload="metadata" loop></audio>
        </section>

        <div class="controls" aria-label="Настроение подсветки">
          <span class="theme-label">Свет вокруг тебя</span>
          <button class="theme-btn" style="--swatch:#ff9bc8" data-theme="rose" aria-label="Розовое свечение" aria-pressed="true"></button>
          <button class="theme-btn" style="--swatch:#b6a2ff" data-theme="lilac" aria-label="Сиреневое свечение" aria-pressed="false"></button>
          <button class="theme-btn" style="--swatch:#ffe0a6" data-theme="gold" aria-label="Золотое свечение" aria-pressed="false"></button>
        </div>
      </section>
    </main>
    <footer>СОЗДАНО ДЛЯ ТВОЕГО ОСОБЕННОГО ДНЯ <span class="heart">♥</span></footer>
  </div>

  <script>
    // Birthday moment: local time, midnight at the start of 27 November 2026.
    const birthday = new Date(2026, 10, 27, 0, 0, 0);
    const ids = ['days', 'hours', 'minutes', 'seconds'];
    const pad = n => String(n).padStart(2, '0');
    function updateCountdown() {
      const now = new Date();
      let diff = birthday - now;
      const labels = document.querySelector('.countdown');
      if (diff <= 0) {
        labels.innerHTML = '<div class="time-box" style="width:auto;padding:16px 25px"><span class="time-value">Сегодня твой день! ✨</span><span class="time-label">С днём рождения, Павла</span></div>';
        document.querySelector('.subtitle').textContent = 'Сегодня твое день рождения. Пусть этот день будет таким же прекрасным, как и ты!';
        return;
      }
      const values = [Math.floor(diff / 86400000), Math.floor(diff / 3600000) % 24, Math.floor(diff / 60000) % 60, Math.floor(diff / 1000) % 60];
      ids.forEach((id, i) => document.getElementById(id).textContent = pad(values[i]));
    }
    updateCountdown();
    setInterval(updateCountdown, 1000);

    // Pointer-following light gives the glass surface a soft, living highlight.
    window.addEventListener('pointermove', event => {
      document.documentElement.style.setProperty('--mx', event.clientX + 'px');
      document.documentElement.style.setProperty('--my', event.clientY + 'px');
    }, { passive: true });

    // Tiny star field, generated locally without external assets.
    const starField = document.getElementById('stars');
    for (let i = 0; i < 42; i++) {
      const star = document.createElement('i');
      star.className = 'star';
      star.style.left = (Math.random() * 100) + '%';
      star.style.top = (Math.random() * 100) + '%';
      star.style.animationDelay = (Math.random() * 4) + 's';
      star.style.animationDuration = (2.3 + Math.random() * 3.5) + 's';
      starField.appendChild(star);
    }

    const themes = {
      rose:   { a: '#ff9bc8', b: '#a68cff', glow: 'rgba(255,155,200,.30)', bg: '#100e1b', bg2: '#1d142b' },
      lilac:  { a: '#c6b5ff', b: '#8d9cff', glow: 'rgba(182,162,255,.34)', bg: '#100f20', bg2: '#1a1934' },
      gold:   { a: '#ffe0a6', b: '#f0a9b9', glow: 'rgba(255,210,145,.30)', bg: '#17111a', bg2: '#2a1b26' }
    };
    document.querySelectorAll('.theme-btn').forEach(button => {
      button.addEventListener('click', () => {
        const theme = themes[button.dataset.theme];
        const root = document.documentElement;
        root.style.setProperty('--accent', theme.a);
        root.style.setProperty('--accent2', theme.b);
        root.style.setProperty('--glow', theme.glow);
        root.style.setProperty('--bg', theme.bg);
        root.style.setProperty('--bg2', theme.bg2);
        document.querySelectorAll('.theme-btn').forEach(b => b.setAttribute('aria-pressed', String(b === button)));
      });
    });

    function confettiBurst() {
      const colors = ['#ffc7df', '#d4c6ff', '#ffe5aa', '#ffffff', '#f3a9c8'];
      for (let i = 0; i < 90; i++) {
        const piece = document.createElement('i');
        piece.className = 'confetti';
        piece.style.left = (Math.random() * 100) + 'vw';
        piece.style.background = colors[Math.floor(Math.random() * colors.length)];
        piece.style.setProperty('--duration', (3 + Math.random() * 3.5) + 's');
        piece.style.setProperty('--drift', ((Math.random() - .5) * 260) + 'px');
        piece.style.animationDelay = (Math.random() * .65) + 's';
        document.body.appendChild(piece);
        piece.addEventListener('animationend', () => piece.remove());
      }
    }
    const surpriseBtn = document.getElementById('surpriseBtn');
    const wish = document.getElementById('wish');
    const giftStage = document.getElementById('giftStage');
    const giftTrigger = document.getElementById('giftTrigger');
    const giftHint = document.getElementById('giftHint');

    function setGiftOpen(opened) {
      wish.classList.toggle('show', opened);
      giftStage.classList.toggle('open', opened);
      giftTrigger.setAttribute('aria-pressed', String(opened));
      giftTrigger.setAttribute('aria-label', opened ? 'Закрыть подарок' : 'Открыть подарок');
      giftHint.textContent = opened ? 'Подарок открыт' : 'Нажми на подарок';
      surpriseBtn.querySelector('span:first-child').textContent = opened ? 'Спрятать пожелание' : 'Открыть сюрприз';
      surpriseBtn.querySelector('span:last-child').textContent = opened ? '✦' : '♡';
      if (opened) confettiBurst();
    }

    giftTrigger.addEventListener('click', () => setGiftOpen(!giftStage.classList.contains('open')));
    surpriseBtn.addEventListener('click', () => setGiftOpen(!giftStage.classList.contains('open')));

    // The site loads the separately uploaded song.mp3 from the same folder as index.html.
    const musicToggleBtn = document.getElementById('musicToggleBtn');
    const musicTrackName = document.getElementById('musicTrackName');
    const musicStatus = document.getElementById('musicStatus');
    const musicCard = document.getElementById('musicCard');
    const birthdayAudio = document.getElementById('birthdayAudio');
    let songReady = false;

    birthdayAudio.addEventListener('loadedmetadata', () => {
      songReady = true;
      musicToggleBtn.disabled = false;
      musicTrackName.textContent = 'song.mp3';
      musicStatus.textContent = 'Песня загружена и готова к воспроизведению';
    });
    birthdayAudio.addEventListener('canplay', () => {
      songReady = true;
      musicToggleBtn.disabled = false;
      musicTrackName.textContent = 'song.mp3';
      musicStatus.textContent = 'Песня готова — нажми «Включить»';
    });

    musicToggleBtn.addEventListener('click', async () => {
      if (!songReady) return;
      if (birthdayAudio.paused) {
        try {
          await birthdayAudio.play();
          musicStatus.textContent = 'Сейчас играет твоя песня';
        } catch (error) {
          musicStatus.textContent = 'Не удалось запустить музыку. Проверь файл song.mp3';
          musicCard.classList.remove('playing');
        }
      } else {
        birthdayAudio.pause();
        musicStatus.textContent = 'Музыка выключена';
      }
    });

    birthdayAudio.addEventListener('play', () => {
      musicCard.classList.add('playing');
      musicToggleBtn.textContent = 'Выключить';
      musicToggleBtn.setAttribute('aria-pressed', 'true');
      musicStatus.textContent = 'Сейчас играет твоя песня';
    });
    birthdayAudio.addEventListener('pause', () => {
      musicCard.classList.remove('playing');
      musicToggleBtn.textContent = 'Включить';
      musicToggleBtn.setAttribute('aria-pressed', 'false');
      if (songReady && musicStatus.textContent === 'Сейчас играет твоя песня') {
        musicStatus.textContent = 'Музыка выключена';
      }
    });
    birthdayAudio.addEventListener('error', () => {
      songReady = false;
      musicToggleBtn.disabled = true;
      musicTrackName.textContent = 'Песня ещё не загружена';
      musicStatus.textContent = 'Не найден song.mp3. Положи песню в ту же папку, что и index.html';
      musicCard.classList.remove('playing');
    });
  </script>
</body>
</html>
